{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cost",
        "tokens"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "files",
    "usage",
    "summary",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
