{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "failure_class": {
      "enum": [
        null,
        "TEST_FAILURE",
        "TRANSIENT_FAILURE",
        "ENVIRONMENT_FAILURE",
        "POLICY_VIOLATION"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "passed",
    "failure_class",
    "evidence",
    "duration_seconds"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgo.local/contracts/1.0/verification_result.schema.json",
  "title": "verification_result"
}
