{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_cost",
        "max_tokens"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "correction": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "unit_id": {
              "type": "string",
              "minLength": 1
            },
            "verdict": {
              "enum": [
                "FAIL",
                "RETRY",
                "REPLAN",
                "BLOCKED"
              ]
            },
            "failure_class": {
              "enum": [
                "TEST_FAILURE",
                "TRANSIENT_FAILURE",
                "ENVIRONMENT_FAILURE",
                "POLICY_VIOLATION",
                "PLANNING_FAILURE",
                "SPECIFICATION_FAILURE"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "minItems": 1
            },
            "scope": {
              "type": "object",
              "properties": {
                "allowed": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  },
                  "minItems": 1
                },
                "forbidden": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "allowed",
                "forbidden"
              ],
              "additionalProperties": false
            },
            "remaining_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "remaining_budget": {
              "type": "object",
              "properties": {
                "max_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "max_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "max_cost",
                "max_tokens"
              ],
              "additionalProperties": false
            },
            "next_action": {
              "enum": [
                "CORRECT",
                "REPLAN"
              ]
            }
          },
          "required": [
            "schema_version",
            "unit_id",
            "verdict",
            "failure_class",
            "reason",
            "evidence",
            "scope",
            "remaining_attempts",
            "remaining_budget",
            "next_action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "unit_id",
    "attempt",
    "objective",
    "allowed_scope",
    "requirements",
    "inputs",
    "budget",
    "idempotency_key",
    "correction",
    "instruction"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgo.local/contracts/1.0/agent_request.schema.json",
  "title": "agent_request"
}
