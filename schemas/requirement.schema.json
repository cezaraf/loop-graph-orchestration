{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rawText": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rawText"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "ADDED",
        "MODIFIED",
        "REMOVED",
        "RENAMED"
      ]
    },
    "rename": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "text",
    "scenarios",
    "capability",
    "operation"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgo.local/contracts/1.0/requirement.schema.json",
  "title": "requirement"
}
