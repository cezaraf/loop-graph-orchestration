{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "RETRY",
        "REPLAN",
        "BLOCKED",
        "HUMAN_APPROVAL_REQUIRED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string",
          "null"
        ]
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "approval_request": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "binding",
        "action",
        "run_id",
        "unit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "unit",
    "verdict",
    "reason",
    "policy",
    "evidence",
    "next_action"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgo.local/contracts/1.0/gate_decision.schema.json",
  "title": "gate_decision"
}
