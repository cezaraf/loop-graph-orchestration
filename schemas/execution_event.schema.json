{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "graph_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "old": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "integrated": {
      "type": "boolean"
    },
    "verified": {
      "type": "boolean"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "active_workers": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision": {
      "type": "object"
    },
    "passed": {
      "type": "boolean"
    },
    "results": {
      "type": "object"
    },
    "result": {
      "type": "object"
    },
    "feedback": {
      "type": "object"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "affected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "finished_at": {
      "type": "number",
      "minimum": 0
    },
    "ready_at": {
      "type": "number",
      "minimum": 0
    },
    "started_at": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "kind"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgo.local/contracts/1.0/execution_event.schema.json",
  "title": "execution_event"
}
