{
  "version": 1,
  "projects": {
    "tipo-exame": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [
              "zone.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "tipo-exame:build"
          }
        }
      }
    }
  }
}